{
  "import_version": "1.0",
  "created_at": "2026-05-08T00:00:00Z",
  "description": "Example import configuration - FICTIONAL PATHS ONLY",
  "entries": [
    {
      "source_path": "C:/Users/Example/Documents/Work/Reports",
      "target_type": "work_documents",
      "rules": {
        "extensions": [".pdf", ".docx", ".xlsx"],
        "exclude": ["temp/", "*.draft.*"]
      },
      "metadata": {
        "category": "work",
        "tags": ["reports", "documents"],
        "priority": "high"
      }
    },
    {
      "source_path": "D:/Example/Learning/Courses",
      "target_type": "educational_materials",
      "rules": {
        "extensions": [".pdf", ".mp4", ".pptx"],
        "patterns": ["**/lecture*", "**/notes/*"]
      },
      "metadata": {
        "category": "education",
        "tags": ["courses", "learning"]
      }
    },
    {
      "source_path": "E:/Example/Archive/2025",
      "target_type": "archived_files",
      "rules": {
        "date_range": {"before": "2025-12-31"},
        "exclude": ["*.tmp", "*.log"]
      },
      "metadata": {
        "category": "archive",
        "tags": ["old", "backup"]
      }
    }
  ],
  "import_settings": {
    "dry_run": false,
    "backup_before_import": true,
    "on_conflict": "skip"
  }
}
